# Copy to .env.local and fill in. Never commit real secrets.

# ---- Supabase (backend) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used only in guarded admin server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://ieeegub.vercel.app
# Shared secret for the scheduled-publish cron route (/api/cron/publish).
CRON_SECRET=

# ---- Chatbot (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Email (contact / partnership / feedback) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ---- GitHub contributors (server-only; was NEXT_PUBLIC_GITHUB_TOKEN) ----
GITHUB_TOKEN=
